{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rikkahub.local/companion/actions.schema.json",
  "title": "Companion Robot Action Catalog v2",
  "type": "object",
  "required": ["version", "limits", "expressions", "categories", "actions"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+$"},
    "updated_at": {"type": "string"},
    "description": {"type": "string"},
    "limits": {"$ref": "#/$defs/limits"},
    "expressions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string"}
    },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string"}
    },
    "actions": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["min", "max", "center"],
      "additionalProperties": true,
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"},
        "center": {"type": "number"},
        "unit": {"type": "string"},
        "positive_direction": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "pan", "tilt", "volume", "intensity", "speed", "repeat",
        "default_max_duration_ms", "hard_max_duration_ms",
        "max_actions_per_turn", "rate_limit_per_second"
      ],
      "additionalProperties": false,
      "properties": {
        "pan": {"$ref": "#/$defs/range"},
        "tilt": {"$ref": "#/$defs/range"},
        "volume": {
          "type": "object",
          "required": ["min", "max", "default", "muted"],
          "additionalProperties": true,
          "properties": {
            "min": {"const": 0},
            "max": {"const": 100},
            "default": {"type": "integer", "minimum": 0, "maximum": 100},
            "muted": {"const": 0},
            "description": {"type": "string"}
          }
        },
        "intensity": {
          "type": "object",
          "required": ["levels", "labels_zh"],
          "additionalProperties": false,
          "properties": {
            "levels": {"type": "array", "const": [1, 2, 3]},
            "labels_zh": {
              "type": "object",
              "required": ["1", "2", "3"],
              "additionalProperties": false,
              "properties": {
                "1": {"type": "string"},
                "2": {"type": "string"},
                "3": {"type": "string"}
              }
            }
          }
        },
        "speed": {
          "type": "object",
          "required": ["levels", "labels_zh", "one_way_ms", "authored_at_level"],
          "additionalProperties": false,
          "properties": {
            "levels": {"type": "array", "const": [1, 2, 3]},
            "labels_zh": {
              "type": "object",
              "required": ["1", "2", "3"],
              "additionalProperties": false,
              "properties": {
                "1": {"type": "string"},
                "2": {"type": "string"},
                "3": {"type": "string"}
              }
            },
            "one_way_ms": {
              "type": "object",
              "required": ["1", "2", "3"],
              "additionalProperties": false,
              "properties": {
                "1": {"type": "integer", "minimum": 1},
                "2": {"type": "integer", "minimum": 1},
                "3": {"type": "integer", "minimum": 1}
              }
            },
            "authored_at_level": {"type": "integer", "enum": [1, 2, 3]}
          }
        },
        "repeat": {
          "type": "object",
          "required": ["min", "max", "default"],
          "additionalProperties": false,
          "properties": {
            "min": {"const": 1},
            "max": {"const": 5},
            "default": {"type": "integer", "minimum": 1, "maximum": 5}
          }
        },
        "default_max_duration_ms": {"type": "integer", "minimum": 1, "maximum": 3000},
        "hard_max_duration_ms": {"type": "integer", "minimum": 3000, "maximum": 5000},
        "max_actions_per_turn": {"type": "integer", "minimum": 1, "maximum": 10},
        "rate_limit_per_second": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "keyframe": {
      "type": "object",
      "required": ["at_ms", "pan", "tilt"],
      "additionalProperties": false,
      "properties": {
        "at_ms": {"type": "integer", "minimum": 0},
        "pan": {"type": "number"},
        "tilt": {"type": "number"},
        "ease": {
          "type": "string",
          "enum": ["linear", "ease_in", "ease_out", "ease_in_out"]
        }
      }
    },
    "supports": {
      "type": "object",
      "required": ["intensity", "speed", "repeat"],
      "additionalProperties": false,
      "properties": {
        "intensity": {"type": "boolean"},
        "speed": {"type": "boolean"},
        "repeat": {"type": "boolean"}
      }
    },
    "default_params": {
      "type": "object",
      "required": ["intensity", "speed", "repeat"],
      "additionalProperties": false,
      "properties": {
        "intensity": {"type": "integer", "enum": [1, 2, 3]},
        "speed": {"type": "integer", "enum": [1, 2, 3]},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "action": {
      "type": "object",
      "required": [
        "name", "label_zh", "category", "semantics", "axes", "supports",
        "default_params", "intensity_scale", "keyframes",
        "linked_expression", "holds_position", "max_duration_ms",
        "llm_description_zh"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
        "label_zh": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "semantics": {"type": "string", "minLength": 1},
        "axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["pan", "tilt"]}
        },
        "supports": {"$ref": "#/$defs/supports"},
        "default_params": {"$ref": "#/$defs/default_params"},
        "intensity_scale": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/keyframe"}
        },
        "linked_expression": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "holds_position": {"type": "boolean"},
        "max_duration_ms": {"type": "integer", "minimum": 1, "maximum": 5000},
        "llm_description_zh": {"type": "string", "minLength": 1}
      }
    }
  }
}
