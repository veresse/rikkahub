  "description": "实体语音陪伴机器人（第二代）动作库单一事实源。Server 工具 Schema、Android App 遥控按钮与 ESP32 固件动作表均从此文件派生。角度单位统一为度（deg）。",
  "limits": {
    "pan": {
      "min": -90.0,
      "max": 90.0,
      "center": 0.0,
      "positive_direction": "right",
      "description": "水平轴，中位 0°，负=左，正=右。"
    },
    "tilt": {
      "min": -20.0,
      "max": 45.0,
      "center": 0.0,
      "positive_direction": "down",
      "description": "俯仰轴，中位 0°，负=抬头，正=低头。"
    },
    "volume": {
      "min": 0,
      "max": 100,
      "default": 70,
      "muted": 0,
      "description": "扬声器音量；0 为静音，但不影响麦克风采集与对话状态机。"
    },
    "intensity": {
      "levels": [1, 2, 3],
      "labels_zh": {
        "1": "轻",
        "2": "中",
        "3": "用力"
      }
    },
    "speed": {
      "levels": [1, 2, 3],
      "labels_zh": {
        "1": "慢",
        "2": "中",
        "3": "快"
      },
      "one_way_ms": {
        "1": 900,
        "2": 500,
        "3": 300
      },
      "authored_at_level": 2
    },
    "repeat": {
      "min": 1,
      "max": 5,
      "default": 1
    },
    "default_max_duration_ms": 3000,
    "hard_max_duration_ms": 5000,
    "max_actions_per_turn": 3,
    "rate_limit_per_second": 10
  },
  "expressions": {
    "idle": "待机/默认表情",
    "listening": "聆听",
    "thinking": "思考/搜索",
    "speaking": "说话",
    "surprised": "惊讶",
    "sleep": "闭眼/睡觉",
    "error": "错误/断网"
