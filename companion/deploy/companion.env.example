# 复制到 /etc/rikkahub/companion.env 并填写真实值；权限保持 600。
# 不要在仓库中提交任何真实密钥。

# 管理员口令：至少配置一项（明文用于首次引导，或使用 PBKDF2 哈希）。
# 生成哈希：python -c "from companion.server.app.security.password import hash_password; print(hash_password('你的口令'))"
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=admin
APP_TOKEN_EXPIRE_DAYS=30

# 数据目录（systemd 下建议保持默认）
# DATA_DIR=/opt/rikkahub/companion/server/data

# 大模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# 语音云服务（本期控制面不启用，预留）
DASHSCOPE_API_KEY=

# 可选：浏览器跨域白名单，JSON 数组；默认关闭
# CORS_ALLOW_ORIGINS=["https://example.com"]
