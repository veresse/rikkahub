# 复制到 /etc/rikkahub/companion.env 并填写真实值；权限保持 600。
# 不要在仓库中提交任何真实密钥。

# 管理员口令：至少配置一项（明文用于首次引导，或使用 PBKDF2 哈希）。
# 生成哈希：python -c "from companion.server.app.security.password import hash_password; print(hash_password('你的口令'))"
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=admin
APP_TOKEN_EXPIRE_DAYS=30

# 数据目录（systemd 下建议保持默认）
# DATA_DIR=/opt/rikkahub/companion/server/data

# 大模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# 语音云服务（阿里云百炼）。VOICE_PROVIDER=mock|unavailable|dashscope；
# 默认 unavailable；选 dashscope 时必须填 DASHSCOPE_API_KEY，否则自动降级。
DASHSCOPE_API_KEY=
# DASHSCOPE_REGION=cn-beijing
# DASHSCOPE_WORKSPACE_ID=
# DASHSCOPE_ASR_MODEL=fun-asr-realtime
# DASHSCOPE_TTS_MODEL=qwen-audio-3.0-tts-flash
# DASHSCOPE_TTS_VOICE=cherry
# DASHSCOPE_TTS_CONTAINER=ogg
# VOICE_PROVIDER=unavailable
# VOICE_ENABLED=true
# VOICE_IDLE_TIMEOUT_SECONDS=300
# VOICE_MAX_TURN_SECONDS=60
# VOICE_ASR_FINAL_GRACE_SECONDS=0.3
# VOICE_TTS_FIRST_PACKET_TIMEOUT_SECONDS=5
# VOICE_SEGMENT_IDLE_TIMEOUT_SECONDS=15
# VOICE_PLAYBACK_DONE_TIMEOUT_SECONDS=10
# VOICE_DOWNLINK_BUFFER_SECONDS=5
# VOICE_DOWNLINK_FRAME_MS=60
# 本地假服务器联调时可用（生产不要指向不可信地址）：
# DASHSCOPE_ASR_WS_URL=
# DASHSCOPE_TTS_HTTP_URL=

# 可选：浏览器跨域白名单，JSON 数组；默认关闭
# CORS_ALLOW_ORIGINS=["https://example.com"]
